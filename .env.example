# Defaults usados pelo servidor. Para carregar este arquivo, use:
# node --env-file=.env server.js
PORT=3000
HOST=127.0.0.1

# Se HOST=0.0.0.0 ou ::, informe os nomes/IPs públicos permitidos, sem esquema,
# porta ou caminho. Exemplo de formato: mcp.seu-dominio.com,localhost
# ALLOWED_HOSTS=

# Opcional: origens exatas para clientes que enviam o cabeçalho Origin.
# Sem configuração, apenas requisições sem Origin são aceitas.
# ALLOWED_ORIGINS=http://localhost:6274
