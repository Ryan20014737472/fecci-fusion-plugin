# Exemplo local. Não envie o arquivo .env ao GitHub. Para carregá-lo, use:
# node --env-file=.env server.js
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Em produção, o Render fornece PORT e RENDER_EXTERNAL_HOSTNAME automaticamente.
# Para domínio próprio, defina apenas o hostname, sem esquema, porta ou caminho:
# PUBLIC_DOMAIN=mcp.seu-dominio.com

# Opcional: outros hosts exatos, somados ao domínio público e ao hostname do Render.
# Exemplo de formato: outro-dominio.com,localhost
# ALLOWED_HOSTS=

# Opcional: origens exatas para clientes que enviam o cabeçalho Origin.
# Sem configuração, apenas requisições sem Origin são aceitas.
# ALLOWED_ORIGINS=http://localhost:6274
